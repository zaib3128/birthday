# Copy this file to ".env" (same folder) and fill it in. Never share the .env file.
PORT=5000
# Your MongoDB link: a local one, or a free MongoDB Atlas link
MONGODB_URI=mongodb://127.0.0.1:27017/birthday
# A long random text. It signs the login tickets. Anyone who knows it can pretend to be anyone, so keep it secret.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-text
# The email you log in with as the SUPER ADMIN (the boss of the site). It can see everyone and manage people.
SUPERADMIN_EMAIL=you@example.com
# The super admin's password. It is used ONLY THE FIRST TIME, to create the super admin account.
# After that, change your password inside the site (My site > Change password). This setting is then ignored.
ADMIN_PASSWORD=choose-a-strong-password
# Optional: the name shown for the super admin account
# SUPERADMIN_NAME=Zohaib
# Optional: how much a new person may keep (the super admin can change it for each person later)
# DEFAULT_MAX_PHOTOS=30
# DEFAULT_MAX_MB=40
# Only needed if the React site is hosted on a different address than this server
# CLIENT_ORIGIN=https://your-site.example.com
# Only for the optional database test (the name must contain the word "test", the test deletes everything in it)
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/birthday_test
